# Copy to .env and edit. .env is gitignored: it holds your credentials and
# they are not saguin's to keep.

# ---------------------------------------------------------------- the model
# One of: ollama, bedrock, azure, gcp.
#
# Only ollama keeps the question on your machine. With any of the other
# three, the question and the documentation retrieved for it are sent to
# that provider - which the interface says, beside the model's name, so
# nobody has to remember it.
SAGUIN_LLM=ollama

# ollama - the default, on ollama's default port. qwen2.5:3b is about 2GB
# and answers on an ordinary laptop; a larger model reasons better through
# the agent loop and costs more per question in time rather than money. host.docker.internal
# reaches the machine running the containers; compose maps it on Linux too,
# where Docker does not provide it. If ollama runs somewhere else, name it.
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# AWS Bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# Google Vertex
# GCP_PROJECT=
# GCP_REGION=us-central1
# GCP_MODEL=gemini-1.5-flash-002
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp.json

# ------------------------------------------------------------------ the app
# Where the interface answers.
SAGUIN_AGENT_PORT=5005

# The checkout to index. Mounted read-only: this reads your documents and
# writes nothing to them.
SAGUIN_DOCS=/docs

# Overrides the commit read from .git, for an image built from an export.
# SAGUIN_COMMIT=

# The context window asked of the model, in tokens.
#
# **This has to be set, not left to the default.** ollama serves a model at
# its own default context - historically 2048 - however large a window the
# model supports, and a prompt longer than that loses its oldest tokens
# silently: the system prompt and the start of the documentation excerpts.
# The answer then cites text the model never saw. 8192 fits five excerpts,
# the instructions and a few turns of the loop.
SAGUIN_LLM_CONTEXT=8192

# How many documentation excerpts each search returns. More context costs
# time on a slow machine, and time is what a local model spends.
SAGUIN_EXCERPTS=15

# How long to wait for one answer. Measured: qwen2.5:3b on a 2014 four-core
# desktop takes over three minutes for one turn of the loop.
SAGUIN_LLM_TIMEOUT=300

# How many turns the agent may take before it must answer with what it has.
# A loop with no bound against a metered provider is a bill with no bound.
SAGUIN_MAX_TURNS=6

# Below this retrieval score, docs-only mode answers "the documentation does
# not say" rather than writing something plausible with no citation under
# it. Raise it if answers are vague; lower it if honest questions are being
# refused.
SAGUIN_MIN_SCORE=0.35
