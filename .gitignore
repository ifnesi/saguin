# Build output: `make build` writes the shipped binary here.
bin/

# Temporary files: make's TMPDIR, the test folders and Go's build scratch.
.tmp/

# Local Python environment and bytecode for the examples.
.venv/
__pycache__/

# Test binaries (`go test -c`), coverage and profiles.
*.test
*.out
*.cover
*.prof
*.pprof

# A local Go workspace, which the module's build must not depend on.
go.work
go.work.sum

# A broker run by hand from the checkout: its database and SQLite's files
# beside it.
*.db
*.db-wal
*.db-shm
*.db-journal

# Editors and operating systems.
.idea/
.vscode/
*.swp
*~
.DS_Store

# Development files kept out of the public repository.
CLAUDE.md
docs/Execution/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/saguin-ask/
!.claude/skills/saguin-config/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/saguin-ask/
!.agents/skills/saguin-config/
