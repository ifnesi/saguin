.PHONY: build check conformance fuzz fuzz-full soak soak-full e2efuzz ci ci-steps load notices

# Recipes can be included by rule-test Makefiles below .tmp, so code paths
# are anchored to this Makefile rather than the invoking directory.
SAGUIN_ROOT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

# Temporary files go to disk, never /tmp, which is RAM on the maintainer's
# machine: Go's build scratch, the binaries
# `go run` makes, and the folders tests create. An inherited TMPDIR is
# ignored on purpose; set SAGUIN_TMPDIR to put them elsewhere.
SAGUIN_TMPDIR ?= $(CURDIR)/.tmp
export TMPDIR := $(SAGUIN_TMPDIR)

# SQLite syncs with fdatasync, as its standard Linux builds do; the embedded
# amalgamation does not detect it, so every build and test defines it
# (design.md, Store). Added once: recipes included by nested makes keep the
# same flags, so Go's build cache still serves them.
ifeq (,$(findstring -DHAVE_FDATASYNC=1,$(CGO_CPPFLAGS)))
export CGO_CPPFLAGS += -DHAVE_FDATASYNC=1
endif

$(SAGUIN_TMPDIR):
	mkdir -p $@

build check conformance fuzz fuzz-full soak soak-full e2efuzz ci ci-steps load notices: | $(SAGUIN_TMPDIR)

# Reproduce licences verbatim from the modules selected for the shipped build,
# then the toolchain and the C libraries linked statically by make build.
# GLIBC_LICENSE may name the build system's LGPL-2.1 text on other systems.
notices:
	@set -eu; \
	cd "$(SAGUIN_ROOT)"; \
	export CGO_ENABLED=1 CC=gcc LC_ALL=C; \
	out=cmd/saguin/THIRD-PARTY-NOTICES.md; \
	work=$$(mktemp -d "$(SAGUIN_TMPDIR)/notices.XXXXXX"); \
	trap 'rm -rf "$$work"; rm -f "$$out.new"' EXIT; \
	trap 'exit 1' HUP INT TERM; \
	go list -tags=netgo,osusergo -deps -f '{{with .Module}}{{if not .Main}}{{.Path}} {{.Version}}{{with .Replace}} => {{.Path}} {{.Version}}{{end}}|{{if .Replace}}{{.Replace.Dir}}{{else}}{{.Dir}}{{end}}{{end}}{{end}}' ./cmd/saguin > "$$work/packages"; \
	sort -u "$$work/packages" > "$$work/modules"; \
	goroot=$$(go env GOROOT); \
	{ \
		printf '# Third-party notices\n\n'; \
		printf 'Generated by `make notices` from the modules linked into the binary.\n'; \
		printf 'The complete source is available at github.com/ifnesi/saguin.\n\n'; \
		printf '## Modules\n\n'; \
		while IFS='|' read -r entry dir; do \
			[ -n "$$entry" ] || continue; \
			printf -- '- %s\n' "$$entry"; \
		done < "$$work/modules"; \
		printf '\n<!-- end of module list -->\n'; \
		while IFS='|' read -r entry dir; do \
			[ -n "$$entry" ] || continue; \
			printf '\n## %s\n' "$$entry"; \
			find "$$dir" -maxdepth 1 -type f \( -iname 'license*' -o -iname 'licence*' -o -iname 'notice*' -o -iname 'copying*' \) > "$$work/files"; \
			sort -o "$$work/files" "$$work/files"; \
			if [ ! -s "$$work/files" ]; then \
				printf 'No licence found for %s\n' "$$entry" >&2; exit 1; \
			fi; \
			while IFS= read -r file; do \
				printf '\n### %s\n\n```\n' "$${file##*/}"; \
				cat "$$file"; \
				printf '\n```\n'; \
			done < "$$work/files"; \
		done < "$$work/modules"; \
		printf '\n## Go\n\n```\n'; \
		cat "$$goroot/LICENSE"; \
		printf '\n```\n'; \
		printf '\n## SQLite\n\n```\n'; \
		printf '%s\n' \
			'The author disclaims copyright to this source code.  In place of' \
			'a legal notice, here is a blessing:' '' \
			'    May you do good and not evil.' \
			'    May you find forgiveness for yourself and forgive others.' \
			'    May you share freely, never taking more than you give.'; \
		printf '```\n'; \
		printf '\n## glibc\n\n```\n'; \
		cat "$${GLIBC_LICENSE:-/usr/share/common-licenses/LGPL-2.1}"; \
		printf '\n```\n'; \
	} > "$$out.new"; \
	mv "$$out.new" "$$out"

# Long runs go under a memory bound, so a runaway dies alone. CI runners have
# no user systemd: CI sets BOUND= to run without it.
BOUND ?= systemd-run --user --scope --quiet -p MemoryMax=4G -p MemorySwapMax=0 --
# The linter `make check` runs: installed with `go install`, which puts it
# outside the PATH.
GOLANGCI_LINT ?= $(HOME)/go/bin/golangci-lint
# How long each fuzz target runs in the per-change suite and in the full
# audit run, how long the short soak and its full audit run last, and how
# long the end-to-end fuzzer runs on every change and in the audit run.
FUZZTIME ?= 5s
FUZZ_FULL_DURATION ?= 1m
SOAK_DURATION ?= 30s
SOAK_FULL_DURATION ?= 10m
E2EFUZZ_DURATION ?= 30s
E2EFUZZ_FULL_DURATION ?= 10m
# Optional go test flags, for example -skip for filesystem probes unavailable
# in a sandbox. Both whole-package stages keep the same selection.
TESTFLAGS ?=
# The whole per-change suite has one budget, in seconds, so adding checks
# cannot silently make every commit's feedback unbounded.
CI_BUDGET ?= 720

build:
	# -p lets repeated builds reuse the existing output directory.
	mkdir -p $(SAGUIN_ROOT)/bin
	# CGO_ENABLED=1 compiles and links SQLite's C implementation.
	# CC=gcc selects the system C toolchain, which links glibc.
	# CGO_CFLAGS=-O2 keeps cgo's default optimization; -g0 omits C debug data.
	# netgo and osusergo select Go's DNS resolver and user/group lookup,
	# excluding glibc's corresponding lookup code.
	# -ldflags passes the two required static-link settings to the Go linker.
	# -linkmode=external lets the Go linker use the selected C toolchain.
	# -extldflags=-static tells that toolchain to produce a static ELF binary.
	# -o places the shipped binary at the path checked by R9.
	CGO_ENABLED=1 CC=gcc CGO_CFLAGS="-O2 -g0" \
		go -C $(SAGUIN_ROOT) build -tags=netgo,osusergo \
		-ldflags="-linkmode=external -extldflags=-static" \
		-o $(SAGUIN_ROOT)/bin/saguin \
		./cmd/saguin

check: build
	# gofmt lists every Go file of the module that is not formatted; any
	# file listed fails the check.
	@unformatted=$$(gofmt -l $$(go list -f '{{.Dir}}/*.go' ./...)); \
		if [ -n "$$unformatted" ]; then echo "gofmt needed:"; echo "$$unformatted"; exit 1; fi
	# go.mod and go.sum list exactly what the code uses, so R9's dependency
	# list has no stray entry; the dependencies on disk are byte for byte the
	# ones go.sum approved.
	go mod tidy -diff
	go mod verify
	# CGO_ENABLED=1 and CC=gcc keep vet on the native glibc SQLite build.
	CGO_ENABLED=1 CC=gcc go vet ./...
	# golangci-lint applies the standard and additional project checks; it is
	# a tool on this machine, not a dependency of the broker.
	CGO_ENABLED=1 CC=gcc $(GOLANGCI_LINT) run ./...
	# -race checks every package with the race detector on native glibc;
	# -shuffle=on runs the tests in a new order each time, so none passes
	# only because of the order it happens to run in. The conformance packages,
	# internal/harness/conformance and those below it, are left to their own
	# stage below, so ci never runs them twice.
	CGO_ENABLED=1 CC=gcc go test -race -shuffle=on $(TESTFLAGS) $$(go list ./... | grep -v '/internal/harness/conformance\($$\|/\)')

# Conformance, fuzz and a short soak run on every change, each through the
# harness (internal/harness). A broker that cannot start fails the run.
conformance: build
	# CGO_ENABLED=1, CC=gcc and -race keep the race detector on these
	# packages, which check leaves to this stage; it instruments the harness,
	# not the broker subprocess. ./internal/harness/conformance/... is the
	# conformance package and those below it, in one go test that runs them
	# side by side: intervals' waits of the design's one-minute intervals pass
	# while conformance's own tests run.
	# -timeout raises Go's default 10-minute package cap for slow machines,
	# not a test's deadline; make ci's CI_BUDGET still bounds the whole suite.
	CGO_ENABLED=1 CC=gcc go test -race -count=1 -v -shuffle=on -timeout 60m $(TESTFLAGS) ./internal/harness/conformance/...

fuzz:
	$(BOUND) go run ./internal/harness/cmd/fuzz -fuzztime $(FUZZTIME) -fuzzminimizetime 1s

# The long fuzz, run in every audit round with the machine to itself.
fuzz-full:
	# Give each target selected by changed lines one minute under the memory bound.
	$(BOUND) go run ./internal/harness/cmd/fuzz -fuzztime $(FUZZ_FULL_DURATION) -since=$(SINCE)
	# Then the broker as a whole, fuzzed end to end from the wire.
	$(MAKE) e2efuzz E2EFUZZ_DURATION=$(E2EFUZZ_FULL_DURATION)

soak: build
	$(BOUND) go run ./internal/harness/cmd/soak -clients 8 -duration $(SOAK_DURATION)

# The broker fuzzed end to end from the wire (design.md, Testing), with a
# random seed the run prints; E2EFUZZ_FLAGS="-seed n" replays one.
e2efuzz: build
	$(BOUND) go run ./internal/harness/cmd/e2efuzz -duration $(E2EFUZZ_DURATION) $(E2EFUZZ_FLAGS)

# make ci runs locally before every commit: everything, in order and within
# one budget. GitHub runs only make check (.github/workflows/ci.yml).
ci:
	# The supervisor owns the suite's process group, budget, and terminal signals.
	go -C $(SAGUIN_ROOT) run ./internal/harness/cmd/ci -budget $(CI_BUDGET)s -started $$(date +%s%N) -- $(MAKE) -C $(CURDIR) --no-print-directory ci-steps

# Kept as prerequisites so make runs the five stages serially and stand-in
# recipes can exercise the budget without starting the real suite.
ci-steps: check conformance fuzz soak e2efuzz

# The full soak, run in every audit round with the machine to itself.
soak-full:
	$(MAKE) soak SOAK_DURATION=$(SOAK_FULL_DURATION)

# The end-to-end baseline of throughput and latency, by the fixed recipe in
# internal/harness/cmd/load/recipe.go: about half an hour, with the machine
# to itself; never part of ci. Its results go to bin/load/.
# The tool runs under this memory bound, the broker in its own scope under
# its own (recipe.go, brokerMemory). LOAD_FLAGS="-sizes
# small -runs 1" tries the tool on part of the recipe; -peer measures the
# tool's headroom against an in-process test peer; -rate supplies the
# fixed mode's total publications per second, outside the recipe.
load: build
	$(BOUND) go run ./internal/harness/cmd/load $(LOAD_FLAGS)

# Outside suites have their own dependencies and budget, so run only by name.
# REPO accepts a local git repository for offline runs. BIN accepts a prebuilt
# Rust runner; its caller is responsible for building it from the stated pin.
# MQTT5TEST_BIN is the selecting runner built by this target at
# bin/interop/mqtt_test-runner/target/release/mqtt_test. The upstream binary
# can select only groups and cannot isolate individual tests.
PAHO_REPO ?= https://github.com/eclipse-paho/paho.mqtt.testing.git
PAHO_SHA ?= 9d7bb80bb8b9d9cfc0b52f8cb4c1916401281103
MQTT5TEST_REPO ?= https://github.com/ifnesi/mqtt_test.git
MQTT5TEST_SHA ?= 26a97ae4e731371c80f0d87993edd2b1fe0b3f52
# Set CARGO_HOME and CARGO_NET_OFFLINE=true to use a writable offline cache.
MQTT5TEST_BIN ?=
MQTTCONF_REPO ?= https://github.com/vibesrc/mqttconformance.git
MQTTCONF_SHA ?= e15945187a48796e8243d4be673f6095d0d5b211
MQTTCONF_BIN ?=
INTEROP_DIR ?= $(SAGUIN_ROOT)/bin/interop
INTEROP_EXPECTED ?= $(SAGUIN_ROOT)/internal/interop
INTEROP_TIMEOUT ?= 90
INTEROP_SUITES ?= paho5 paho311 mqtt5test mqttconf5 mqttconf311
# An exact test name for diagnosis or checking an expected-list change.
INTEROP_TEST ?=
export SAGUIN_ROOT PAHO_REPO PAHO_SHA MQTT5TEST_REPO MQTT5TEST_SHA MQTT5TEST_BIN
export MQTTCONF_REPO MQTTCONF_SHA MQTTCONF_BIN INTEROP_DIR INTEROP_EXPECTED
export INTEROP_TIMEOUT INTEROP_SUITES INTEROP_TEST

.PHONY: interop
interop: build
	$(BOUND) sh $(SAGUIN_ROOT)/internal/interop/run.sh

# Hand-run Python tours, deliberately outside check and ci. Credentials are
# staged under /var/tmp/saguin-demo, where the example names them.
.PHONY: demo demo-full demo-server
demo: build
	@test -x .venv/bin/python || { echo "make demo needs .venv; run: python3 -m venv .venv && . .venv/bin/activate && pip install -r examples/requirements.txt"; exit 1; }
	./.venv/bin/python examples/demo.py --skip-build

demo-full: build
	@test -x .venv/bin/python || { echo "make demo-full needs .venv; run: python3 -m venv .venv && . .venv/bin/activate && pip install -r examples/requirements.txt"; exit 1; }
	./.venv/bin/python examples/demo.py --skip-build --full

demo-server: build
	python3 examples/demo.py --credentials
	./bin/saguin --config examples/saguin.yaml
